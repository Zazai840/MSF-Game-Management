{
  "name": "msf-running-zone",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "local": "docker compose up --build",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "vite build && node scripts/budget.mjs && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "test:e2e": "playwright test && playwright test -c playwright.test-build.config.ts",
    "test:remote": "playwright test -c playwright.remote.config.ts",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "prototype:no-final": "node scripts/prototype-results-without-a-final.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/middie": "^9.3.5",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "read-excel-file": "9.3.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
